{
  "name": "@fluffmind/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/cli.ts",
  "types": "./src/cli.ts",
  "bin": {
    "fluffmind": "./src/bin.ts"
  },
  "scripts": {
    "build": "echo \"@fluffmind/cli: nothing to build yet, source-run via node --experimental-strip-types\"",
    "start": "node --experimental-strip-types src/bin.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
