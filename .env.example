# Copy to .env for local Docker Compose usage (docker-compose.yml reads it automatically).

# Absolute path on your host machine to the markdown vault to serve — e.g. this
# Foam vault. Bind-mounted read-write into the container (writes land here).
VAULT_PATH=/absolute/path/to/your/vault

# When true, reject all vault mutations (HTTP 403). Exact string "true" only.
# Portable launcher: --readonly sets this. UI may still look editable (server enforces).
# VAULT_READONLY=true

# Disable the filesystem watcher that keeps the read index fresh on external edits.
# Set to the exact string "false" to turn it off (e.g. large vaults / CI). Default: on.
# VAULT_WATCH=false

# Git sync (P1) — both optional. Without GIT_REMOTE_URL, writes still commit locally
# to VAULT_PATH (git init'd automatically), just never pushed — local-only
# self-hosting without GitHub. To push, use an HTTPS remote with an embedded token,
# e.g. https://x-access-token:<PAT>@github.com/<owner>/<repo>.git
# Also set these in Coolify's environment UI when using docker-compose.coolify.yml.
# GIT_REMOTE_URL=
# GIT_BRANCH=main
# Live sync mode for auth-off / solo (PRD-042). Default git-live.
# mesh-live: note saves skip Git commit/push (Git = export/backup/interop only).
# Auth-on: set per workspace via workspace_config.sync_mode (not this env).
# SYNC_MODE=git-live
# Optional device id for auth-off mesh-live writers (default: solo).
# SYNC_WRITER_DEVICE=laptop-1
# Portable: point the UI at local fluffmind-daemon. When set, note autosave
# prefers daemon PUT /v1/notes via Nitro /__daemon proxy (no Nuxt Git vault API).
# The portable launcher starts the bundled daemon and exports this itself
# (--no-daemon opts out; --daemon-port / FLUFFMIND_DAEMON_PORT change 8787).
# From source: mise exec -- cargo run -p fluffmind-daemon -- --vault "$VAULT_PATH"
# Read at runtime (NUXT_PUBLIC_*); the /__daemon proxy answers only when auth is off.
# NUXT_PUBLIC_DAEMON_URL=http://127.0.0.1:8787
# Daemon bearer token: required when it binds a non-loopback --host (hosted internal
# network). Read by the daemon and by Nuxt server-side; never reaches the browser
# (no /__daemon proxy carries it). Required by docker-compose.yml (no default token).
# FLUFFMIND_DAEMON_TOKEN=
# Mesh sync (PRD-042, ADR-020): Nuxt-server -> daemon base URL. When set, Nuxt pushes
# vault config (PUT /v1/vaults/:id), reports mesh-live writes (POST /v1/mesh/changed)
# and reads remote changes (GET /v1/events). Server-side only; unset = no mesh peer.
# Compose: the `sync` service (Dockerfile target `daemon`) is wired by default at
# http://sync:8787 — internal network only, with FLUFFMIND_DAEMON_TOKEN as bearer.
# FLUFFMIND_DAEMON_URL=http://127.0.0.1:8787
# Daemon-side: iroh relay URL for NAT traversal (self-hosted iroh-relay; n0 public relay if unset).
# Self-host it with the compose `relay` profile (`docker compose --profile relay up`, or
# COMPOSE_PROFILES=relay on Coolify) and put its public https URL here.
# FLUFFMIND_RELAY_URL=
# Daemon-side: set to 1 to dial peers on direct addresses only (LAN / tests, no relay).
# FLUFFMIND_MESH_DIRECT=
# Daemon-side: seconds between fallback pulls of every peer (default 60); 0/unset = default.
# FLUFFMIND_SYNC_INTERVAL_SECS=
# Daemon-side: set to 0 to disable LAN (mDNS) discovery.
# FLUFFMIND_MESH_MDNS=
# Writer device id: must match between Nuxt and the daemon (compose passes it to both).
# SYNC_WRITER_DEVICE=
# Daemon-side: where the node key (node.key, 0600) and per-vault mesh state live.
# FLUFFMIND_DAEMON_DATA=
# GITHUB_WEBHOOK_SECRET=   # HMAC secret for POST /api/webhooks/github (push events)

# GitHub App (self-hosted instance) — optional; PAT workspace link remains fallback.
# Full operator guide: README.md § "GitHub App setup (self-hosted)".
# Create a GitHub App on your org/user with permissions: Contents R/W, Metadata R,
# Administration R/W (create repos on workspace create), Members/collaborators R.
# Set the webhook URL to POST /api/webhooks/github on your
# public Fluffmind URL (push + installation events).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=   # PEM; use \n for newlines in .env
# GITHUB_APP_SLUG=          # for install URL (https://github.com/apps/<slug>/installations/new)
# GITHUB_APP_WEBHOOK_SECRET=  # preferred; else GITHUB_WEBHOOK_SECRET above

# Auth/workspaces (P2) — optional until auth is enabled.
# AUTH_DISABLED=true keeps P1 behavior even when DATABASE_URL is set (Coolify default).
AUTH_DISABLED=true
# When enabling auth on Coolify, also set BETTER_AUTH_SECRET (32+ random bytes) and
# BETTER_AUTH_URL to your public URL (e.g. https://fluffmind.example.com).
# WORKSPACES_ROOT is used when auth is enabled (one directory per workspace).
WORKSPACES_ROOT=/data/workspaces
# BETTER_AUTH_SECRET should be a random 32+ bytes value in production.
BETTER_AUTH_SECRET=
# Public URL used by Better Auth callbacks.
BETTER_AUTH_URL=http://localhost:3000
# Fallback for the public app URL when BETTER_AUTH_URL is unset (Better Auth base URL
# and client-side auth origin both read it). Prefer setting BETTER_AUTH_URL directly.
# APP_BASE_URL=http://localhost:3000
# When auth is enabled: public signup is closed by default. Set to true to allow
# open registration. Invite-only still allows signup for emails with a pending invite
# (and always allows the first user bootstrap).
# AUTH_PUBLIC_SIGNUP=false
# GitHub OAuth app credentials (required for GitHub login when auth is enabled).
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts workspace GitHub PAT tokens at rest (settings link). Recommended in
# production when auth is on; falls back to NUXT_SESSION_PASSWORD then a weak
# dev default if unset.
# GITHUB_SYNC_TOKEN_SECRET=

# MCP — local stdio uses VAULT_PATH; remote HTTP uses workspace tokens
# (Settings → workspace → MCP). See README § MCP / apps/docs/guide/mcp.md.
# MCP_WORKSPACE_ID=default

# Postgres — required when auth is enabled (`AUTH_DISABLED=false`).
# Also used for P7a distributed workspace locks when set (even if AUTH_DISABLED=true).
POSTGRES_USER=fluffmind
POSTGRES_PASSWORD=fluffmind
POSTGRES_DB=fluffmind
# DATABASE_URL=postgres://fluffmind:fluffmind@localhost:5432/fluffmind

# Workspace lock wait (P7a) — max ms to wait for Postgres advisory / file lock before 503.
# LOCK_WAIT_MS=45000
